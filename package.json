{
  "name": "keyhole",
  "version": "0.1.0",
  "private": true,
  "description": "See who can change the contract you're about to trust (NEAR).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "factcheck": "tsx scripts/factcheck.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "survey": "tsx scripts/survey.ts",
    "inspect": "keyhole inspect",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "watch": "tsx watcher/src/index.ts",
    "build:web": "npm run -w @keyhole/web build",
    "test:web": "npm run build:web && node web/tests/run-smoke.mjs",
    "attest:builds": "tsx scripts/attest-builds.ts",
    "demo:attack": "tsx scripts/demo-attack.ts",
    "review": "tsx reviewer/src/cli.ts",
    "eval:review": "tsx scripts/eval-review.ts",
    "eval": "tsx scripts/eval.ts",
    "judge": "tsx scripts/judge.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bs58": "^6.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "near-api-js": "^7.4.0"
  }
}
